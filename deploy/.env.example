# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# Public hostname. Caddy serves it on 443; Django only accepts this Host.
HC_DOMAIN=hc.example.org
SITE_ROOT=https://hc.example.org
ALLOWED_HOSTS=hc.example.org
# Caddy is the only ingress and always sets X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
SITE_NAME=Mychecks
REGISTRATION_OPEN=False

DB=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=hc
DB_USER=postgres
DB_PASSWORD=change-me
DB_CONN_MAX_AGE=0
DB_SSLMODE=prefer
DB_TARGET_SESSION_ATTRS=read-write

DEFAULT_FROM_EMAIL=healthchecks@example.org
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_VERIFICATION=True

WEBHOOKS_ENABLED=True
# Keep False in production: blocks webhooks to private/internal IPs.
INTEGRATIONS_ALLOW_PRIVATE_IPS=False
